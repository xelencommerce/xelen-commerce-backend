{
  "name": "xelen-commerce-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23 || >=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node dist/src/main.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/integration",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "local:init": "tsx scripts/local-init.ts",
    "local:postgres": "tsx scripts/local-postgres.ts",
    "admin:create": "npm run build && node dist/scripts/create-admin.js",
    "auth:cleanup": "npm run build && node dist/scripts/cleanup.js",
    "openapi": "npm run build && node dist/scripts/openapi.js",
    "local:docker": "tsx scripts/docker-env.ts",
    "db:migrate:test": "tsx scripts/migrate-test.ts",
    "predev": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "libphonenumber-js": "^1.13.17",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "^10.6.1",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "effect": "3.22.5",
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
